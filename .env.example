# Copy this file to .env and fill in your values, then: source .env
# NEVER commit .env to git.

# Gmail address and App Password — REQUIRED
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google account)
EMAIL_FROM=your@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Display name shown in recipients' inboxes — optional (default: ClearJet Pressure Washing)
FROM_NAME=ClearJet Pressure Washing

# SMTP server — optional (defaults shown; change for Outlook, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Physical mailing address — REQUIRED for CAN-SPAM compliance
PHYSICAL_ADDRESS=ClearJet Pressure Washing LLC, Memphis, TN 38117

# Unsubscribe destination — REQUIRED for CAN-SPAM compliance
# Replace with a real URL once you have a domain
UNSUBSCRIBE_URL=mailto:unsubscribe@clearjetpw.com?subject=unsubscribe

# Max initial emails to send per run — optional (default: 25)
# Ramp up slowly to avoid Gmail spam filters: 25 → 50 → 100
DAILY_LIMIT=25
